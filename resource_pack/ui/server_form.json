      "$text_name": "#title_text",
      "$title_text_binding_type": "none",
      "$child_control": "server_form.long_form_panel",
      "layer": 2,

      "bindings": [
        {
            "binding_name": "#title_text"
        },
        {
            "binding_type": "view",
            "source_property_name": "(not ((not ((#title_text - $admin - $community - $communityMOBILE - $adminMOBILE - $communityOG - $adminOG - '§❖§C§R' - '§❖§D§R' - '§❖§L§G') = #title_text)))))",
            "target_property_name": "#visible"
        }
      ]
    },

