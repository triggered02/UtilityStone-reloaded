





{
    "namespace": "server_form",
  
    "third_party_server_screen@common.base_screen": {
      "$screen_content": "server_form.main_screen_content",
      
      "button_mappings": [
        {
          "from_button_id": "button.menu_cancel",
          "to_button_id": "button.menu_exit",
          "mapping_type": "global"
        }
      ]
    },

  "main_screen_content": {
    "type": "panel",
    "size": [
      0,
      0
    ],
    "controls": [
      {
        "server_form_factory": {
          "type": "factory",
          "control_ids": {
            "long_form": "@server_form.long_form",
            "custom_form": "@server_form.custom_form"
          }
        }
      }
    ],
    "modifications": [
      {
        "array_name": "controls",
        "operation": "insert_back",
        "value": [
          {
            "obsidian": {
              "type": "panel",
              "factory": {
                "name": "server_form_factory",
                "control_ids": {
                  "long_form": "@server_form.community_form",
                  "custom_form": "@server_form.communitym_form"
                }
              }
            }
          },
          {
            "obsidian2": {
              "type": "panel",
              "factory": {
                "name": "server_form_factory",
                "control_ids": {
                  "long_form": "@server_form.admin_form",
                  "custom_form": "@server_form.adminm_form"
                }
              }
            }
          },
          {
            "obsidian3": {
              "type": "panel",
              "factory": {
                "name": "server_form_factory",
                "control_ids": {
                  "long_form": "@server_form.credits_form"
                }
              }
            }
          },
          {
            "daily_rewards": {
              "type": "panel",
              "factory": {
                "name": "server_form_factory",
                "control_ids": {
                  "long_form": "@daily_rewards.daily_rewards_form"
                }
              }
            }
          },
          {
            "changelogs": {
              "type": "panel",
              "factory": {
                "name": "server_form_factory",
                "control_ids": {
                  "long_form": "@changelogs.changelogs_form"
                }
              }
            }
          }
        ]
      }
    ]
  },
    "long_form@common_dialogs.main_panel_no_buttons": {
      "$title_panel": "common_dialogs.standard_title_label",
      "$title_size": [ "100% - 14px", 10 ],
