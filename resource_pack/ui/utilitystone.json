{
    "namespace": "utilitystone",

    "player_menu_form": {
            "type": "panel",
            "size": [ "100%", "100%" ],
            "controls": [
                {
                    "screen_dim": {
                        "type": "image",
                        "texture": "textures/ui/Black",
                        "color": [ 0, 0, 0 ],
                        "alpha": 0.5,
                        "anchor_from": "center",
                        "anchor_to": "center",
                        "size": [ 10000, 10000 ],
                        "layer": 0
                    }
                },
                {
                    "main_panel": {
                        "type": "panel",
                        "anchor_from": "center",
                        "anchor_to": "center",
                        "size": [ 405, 200 ],
                        "controls": [
                            {
                                "background": {
                                    "type": "image",
                                    "texture": "textures/ui/community_bg",
                                    "anchor_from": "top_middle",
                                    "anchor_to": "top_middle",
                                    "size": [ "100%", "100%" ],
                                    "alpha": 1.0,
                                    "layer": 1
                                }
                            },
                            {
                                "title": {
                                    "type": "label",
                                    "text": "#title_text",
                                    "color": [ 1, 1, 1 ],
                                    "font_type": "MinecraftTen",
                                    "backup_font_type": "MinecraftTen",
                                    "font_scale_factor": 1.4,
                                    "text_alignment": "center",
                                    "anchor_from": "top_middle",
                                    "anchor_to": "top_middle",
                                    "offset": [ 0, -13 ],
                                    "size": [ "100% - 32px", 20 ],
                                    "layer": 5,
                                    "shadow": true
                                }
                            },
                            {
                                "body_background": {
                                    "type": "image",
                                    "texture": "textures/ui/c_body_background",
                                    "anchor_from": "top_middle",
                                    "anchor_to": "top_middle",
                                    "size": [ "88%", 48 ],
                                    "offset": [ 0, 22 ],
                                    "alpha": 0.55,
                                    "layer": 2
                                }
                            },
                            {
                                "body": {
                                    "type": "label",
                                    "text": "#form_text",
                                    "color": [ 1, 1, 1 ],
                                    "font_type": "MinecraftTen",
                                    "backup_font_type": "MinecraftTen",
                                    "text_alignment": "center",
                                    "anchor_from": "top_middle",
                                    "anchor_to": "top_middle",
                                    "offset": [ 0, 36 ],
                                    "size": [ "84%", 40 ],
                                    "layer": 5
                                }
                            },
                            {
                                "buttons_stack@utilitystone.buttons_stack": {}
                            },
                            {
                                "close_button": {
                                    "type": "button",
                                    "anchor_from": "top_right",
                                    "anchor_to": "top_right",
                                    "size": [ 15, 15 ],
                                    "offset": [ -3, 3 ],
                                    "layer": 10,
                                    "sound_name": "random.click",
                                    "sound_volume": 1.0,
                                    "sound_pitch": 1.0,
                                    "$pressed_button_name": "button.menu_exit",
                                    "controls": [
                                        {
                                            "default": {
                                                "type": "image",
                                                "texture": "textures/ui/credits_close_d",
                                                "size": [ "100%", "100%" ],
                                                "layer": 0
                                            }
                                        },
                                        {
                                            "hover": {
                                                "type": "image",
                                                "texture": "textures/ui/credits_close_h",
                                                "size": [ "100%", "100%" ],
                                                "layer": 1
                                            }
                                        },
                                        {
                                            "pressed": {
                                                "type": "image",
                                                "texture": "textures/ui/credits_close_p",
                                                "size": [ "100%", "100%" ],
                                                "layer": 2
                                            }
                                        }
                                    ]
                                }
                            }
                        ],
                        "bindings": [
                            {
                                "binding_name": "#title_text"
                            },
                            {
                                "binding_type": "view",
                                "source_property_name": "(not ((#title_text - $utilitystone) = #title_text))",
                                "target_property_name": "#visible"
                            }
                        ]
                    }
                }
            ]
    },

    "buttons_stack": {
        "type": "stack_panel",
        "size": [ "85%", "100%c" ],
        "orientation": "vertical",
        "anchor_from": "top_middle",
        "anchor_to": "top_middle",
        "offset": [ 0, 78 ],
        "layer": 4,
        "factory": {
            "name": "buttons",
            "control_name": "utilitystone.ust_button"
        },
        "collection_name": "form_buttons",
        "bindings": [
            {
                "binding_name": "#form_button_contents",
                "binding_name_override": "#collection_length"
            }
        ]
    },

    "ust_button": {
        "type": "panel",
        "size": [ "100%", 30 ],
        "controls": [
            {
                "main@common.button": {
                    "$pressed_button_name": "button.form_button_click",
                    "size": [ "100%", "100%" ],
                    "anchor_from": "top_left",
                    "anchor_to": "top_left",
                    "bindings": [
                        {
                            "binding_type": "collection_details",
                            "binding_collection_name": "form_buttons"
                        }
                    ],
                    "controls": [
                        {
                            "default": {
                                "type": "image",
                                "texture": "textures/ui/default_c_button",
                                "size": [ "100%", "100%" ],
                                "layer": 0,
                                "controls": [
                                    {
                                        "content@utilitystone.ust_button_content": {}
                                    }
                                ]
                            }
                        },
                        {
                            "hover": {
                                "type": "image",
                                "texture": "textures/ui/hover_c_button",
                                "size": [ "100%", "100%" ],
                                "layer": 1,
                                "controls": [
                                    {
                                        "content@utilitystone.ust_button_content": {}
                                    }
                                ]
                            }
                        },
                        {
                            "pressed": {
                                "type": "image",
                                "texture": "textures/ui/pressed_c_button",
                                "size": [ "100%", "100%" ],
                                "layer": 2,
                                "controls": [
                                    {
                                        "content@utilitystone.ust_button_content": {}
                                    }
                                ]
                            }
                        },
                        {
                            "b_text": {
                                "type": "label",
                                "text": "#form_button_text",
                                "color": [ 1, 1, 1 ],
                                "font_type": "MinecraftTen",
                                "backup_font_type": "MinecraftTen",
                                "anchor_from": "center",
                                "anchor_to": "center",
                                "offset": [ 0, 0 ],
                                "layer": 100,
                                "size": [ "100% - 56px", 18 ],
                                "font_scale_factor": 1.0,
                                "text_alignment": "center",
                                "bindings": [
                                    {
                                        "binding_name": "#form_button_text",
                                        "binding_type": "collection",
                                        "binding_collection_name": "form_buttons"
                                    }
                                ]
                            }
                        }
                    ]
                }
            }
        ]
    },

    "ust_button_content": {
        "type": "stack_panel",
        "size": [ "100%", "100%" ],
        "orientation": "horizontal",
        "controls": [
            {
                "icon_panel": {
                    "type": "panel",
                    "size": [ -34, "100%c" ],
                    "offset": [ 0, 0 ],
                    "bindings": [
                        {
                            "binding_type": "view",
                            "source_control_name": "icon_image",
                            "resolve_sibling_scope": true,
                            "source_property_name": "(not (#texture = ''))",
                            "target_property_name": "#visible"
                        }
                    ],
                    "controls": [
                        {
                            "icon_image": {
                                "type": "image",
                                "layer": 9,
                                "size": [ 32, 32 ],
                                "offset": [ 0, 0 ],
                                "anchor_from": "center",
                                "anchor_to": "center",
                                "texture": "#form_button_texture",
                                "bindings": [
                                    {
                                        "binding_name": "#form_button_texture",
                                        "binding_name_override": "#texture",
                                        "binding_type": "collection",
                                        "binding_collection_name": "form_buttons"
                                    },
                                    {
                                        "binding_name": "#form_button_texture_file_system",
                                        "binding_name_override": "#texture_file_system",
                                        "binding_type": "collection",
                                        "binding_collection_name": "form_buttons"
                                    },
                                    {
                                        "binding_type": "view",
                                        "source_property_name": "(not ((#texture = '') or (#texture = 'loading')))",
                                        "target_property_name": "#visible"
                                    }
                                ]
                            }
                        },
                        {
                            "progress@progress.progress_loading_bars": {
                                "size": [ 30, 4 ],
                                "offset": [ -2, 16 ],
                                "bindings": [
                                    {
                                        "binding_type": "view",
                                        "source_control_name": "icon_image",
                                        "resolve_sibling_scope": true,
                                        "source_property_name": "(#texture = 'loading')",
                                        "target_property_name": "#visible"
                                    }
                                ]
                            }
                        }
                    ]
                }
            },
            {
                "chevron_panel": {
                    "type": "panel",
                    "size": [ -20, "100%c" ],
                    "anchor_from": "right_middle",
                    "anchor_to": "right_middle",
                    "controls": [
                        {
                            "chevron_default": {
                                "type": "image",
                                "texture": "textures/icons/Arrow_Right_Curved",
                                "size": [ 14, 10 ],
                                "anchor_from": "right_middle",
                                "anchor_to": "right_middle",
                                "offset": [ -6, 0 ],
                                "layer": 50
                            }
                        }
                    ]
                }
            }
        ]
    }
}